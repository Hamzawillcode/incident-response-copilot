# Copy to .env and fill in. Never commit .env.
# Free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Gemini model used by the agents (any Gemini model your key can use)
COPILOT_MODEL=gemini-2.5-flash

# Observability backends (defaults shown)
# PROMETHEUS_URL=http://localhost:9090
# OPENSEARCH_URL=http://localhost:9200
# JAEGER_URL=http://localhost:16686/jaeger/ui

# Knowledge base (Week 3): Postgres + pgvector from docker-compose.yml (defaults shown)
# KB_DATABASE_URL=postgresql://copilot:copilot@localhost:5433/copilot
# Gemini embedding model for runbook/postmortem search (needs GOOGLE_API_KEY; without it, keyword search only)
# KB_EMBEDDING_MODEL=gemini-embedding-001

# Incident team (Week 4)
# Gemini free tier: 5 requests/minute and 20/day per model. Pace the team:
# COPILOT_LLM_RPM=5
# ADK sessions: "postgres" (default, the kb-postgres container) or "memory"
# COPILOT_SESSIONS=postgres
# Traces of the copilot itself, to the copilot-jaeger container (never the demo's collector)
# COPILOT_OTLP_ENDPOINT=http://localhost:4328/v1/traces
# Remediation: report what would change, without changing anything
# COPILOT_ACTIONS_DRY_RUN=1
# The demo's settings file that rollback_config edits (default shown)
# FLAGD_CONFIG_PATH=opentelemetry-demo/src/flagd/demo.flagd.json
